<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.ReporteController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Reportes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Filtros compartidos: el mismo rango de fechas aplica a Prestamos y Reservas -->
    <HBox spacing="10">
        <Button text="Hoy" onAction="#handleHoy"/>
        <Button text="Esta semana" onAction="#handleSemana"/>
        <Button text="Esta quincena" onAction="#handleQuincena"/>
        <Button text="Este mes" onAction="#handleMes"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Desde:"/>
        <DatePicker fx:id="fechaInicio"/>
        <Label text="Hasta:"/>
        <DatePicker fx:id="fechaFin"/>
        <Button text="Generar" onAction="#handleGenerar"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ============ TAB 1: PRESTAMOS ============ -->
        <Tab text="Prestamos">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                    <VBox spacing="16">
                        <padding>
                            <Insets top="10" bottom="10" left="4" right="10"/>
                        </padding>

                        <GridPane hgap="20" vgap="8">
                            <Label text="Total prestamos:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="labelTotal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Activos:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="labelActivos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Devueltos:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="labelDevueltos" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Monto recaudado:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="labelMonto" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Label text="Por sede" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="tablaPorSede" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colSedeNombre" text="Sede" prefWidth="150"/>
                                <TableColumn fx:id="colSedeCantidad" text="Cantidad" prefWidth="100"/>
                                <TableColumn fx:id="colSedeMonto" text="Monto" prefWidth="120"/>
                            </columns>
                        </TableView>

                        <Label text="Por tipo de vehiculo" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="tablaPorTipo" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colTipoNombre" text="Tipo" prefWidth="150"/>
                                <TableColumn fx:id="colTipoCantidad" text="Cantidad" prefWidth="100"/>
                                <TableColumn fx:id="colTipoMonto" text="Monto" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </ScrollPane>
            </content>
        </Tab>

        <!-- ============ TAB 2: RESERVAS ============ -->
        <Tab text="Reservas">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                    <VBox spacing="16">
                        <padding>
                            <Insets top="10" bottom="10" left="4" right="10"/>
                        </padding>

                        <GridPane hgap="20" vgap="8">
                            <Label text="Total reservas:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="labelAgendaTotal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Confirmadas:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label fx:id="labelAgendaConfirmadas" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                            <Label text="Pendientes:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="labelAgendaPendientes" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Finalizadas:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <Label fx:id="labelAgendaFinalizadas" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                            <Label text="Canceladas:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="labelAgendaCanceladas" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Label text="Reservas por dia de la semana" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="tablaAgendaPorDia" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="colAgendaDiaEtiqueta" text="Dia" prefWidth="150"/>
                                <TableColumn fx:id="colAgendaDiaCantidad" text="Cantidad" prefWidth="120"/>
                            </columns>
                        </TableView>

                        <Label text="Reservas por mes" style="-fx-font-weight: bold;"/>
                        <TableView fx:id="tablaAgendaPorMes" prefHeight="160">
                            <columns>
                                <TableColumn fx:id="colAgendaMesEtiqueta" text="Mes" prefWidth="150"/>
                                <TableColumn fx:id="colAgendaMesCantidad" text="Cantidad" prefWidth="120"/>
                            </columns>
                        </TableView>
                    </VBox>
                </ScrollPane>
            </content>
        </Tab>

        <!-- ============ TAB 3: FLOTA ============ -->
        <Tab text="Flota">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                    <VBox spacing="16">
                        <padding>
                            <Insets top="10" bottom="10" left="4" right="10"/>
                        </padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Refrescar" onAction="#handleRefrescarVehiculos"/>
                        </HBox>

                        <GridPane hgap="20" vgap="8">
                            <Label text="Disponibles:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="labelCantDisponibles" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Alquilados:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label fx:id="labelCantAlquilados" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                            <Label text="En mantenimiento:" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
                            <Label fx:id="labelCantMantenimiento" GridPane.rowIndex="0" GridPane.columnIndex="5"/>
                        </GridPane>

                        <TableView fx:id="tablaVehiculosEstado" prefHeight="350">
                            <columns>
                                <TableColumn fx:id="colVehEstadoPlaca" text="Placa" prefWidth="120"/>
                                <TableColumn fx:id="colVehEstadoTipo" text="Tipo" prefWidth="150"/>
                                <TableColumn fx:id="colVehEstadoSituacion" text="Situacion" prefWidth="150"/>
                            </columns>
                        </TableView>
                    </VBox>
                </ScrollPane>
            </content>
        </Tab>

    </TabPane>
</VBox>