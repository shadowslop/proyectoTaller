<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.TipoVehiculoController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Tipos de Vehiculo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoNombre" promptText="Nombre del tipo (ej: Van, Bus)"/>
        <TextField fx:id="campoPrecio" promptText="Precio por dia (ej: 120.000)"/>
        <Button fx:id="botonGuardar" text="Crear tipo" onAction="#handleGuardar"/>
        <Button fx:id="botonCancelarEdicion" text="Cancelar edicion" onAction="#handleCancelarEdicion" visible="false" managed="false"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <TableView fx:id="tablaTipos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="colPrecio" text="Precio/dia" prefWidth="140"/>
            <TableColumn fx:id="colActivo" text="Estado" prefWidth="100"/>
            <TableColumn fx:id="colAccion" text="Accion" prefWidth="220" minWidth="220"/>
        </columns>
    </TableView>
</VBox>