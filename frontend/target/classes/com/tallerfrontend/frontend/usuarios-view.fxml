<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.UsuarioController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Gestion de Sedes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoNombreSede" promptText="Nombre de la sede"/>
        <Button text="Crear sede" onAction="#handleCrearSede"/>
    </HBox>

    <Label fx:id="labelErrorSede" style="-fx-text-fill: red;" visible="false"/>

    <Separator/>

    <Label text="Gestion de Administradores" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoNombre" promptText="Nombre de usuario"/>
        <PasswordField fx:id="campoPassword" promptText="Contraseña"/>
        <ComboBox fx:id="comboRol" promptText="Rol"/>
        <ComboBox fx:id="comboSede" promptText="Sede"/>
        <Button text="Crear administrador" onAction="#handleCrear"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>