<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.ClienteController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Gestion de Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="campoCedula" promptText="Cedula"/>
        <TextField fx:id="campoNombre" promptText="Nombre"/>
        <TextField fx:id="campoApellido" promptText="Apellido"/>
        <TextField fx:id="campoTelefono" promptText="Telefono"/>
        <TextField fx:id="campoNumeroLicencia" promptText="Numero de licencia"/>
        <DatePicker fx:id="fechaLicencia" promptText="Vencimiento licencia"/>
        <Button fx:id="botonGuardar" text="Crear cliente" onAction="#handleCrear"/>
        <Button fx:id="botonCancelarEdicion" text="Cancelar" onAction="#handleCancelarEdicion"
                visible="false" managed="false"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Buscar:"/>
        <TextField fx:id="campoBuscar" promptText="Cedula, nombre, apellido, telefono o licencia" prefWidth="380"/>
    </HBox>

    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCedula" text="Cedula" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100"/>
            <TableColumn fx:id="colApellido" text="Apellido" prefWidth="100"/>
            <TableColumn fx:id="colTelefono" text="Telefono" prefWidth="100"/>
            <TableColumn fx:id="colNumeroLicencia" text="No. Licencia" prefWidth="110"/>
            <TableColumn fx:id="colLicencia" text="Vencimiento licencia" prefWidth="140"/>
            <TableColumn fx:id="colAccion" text="Accion" prefWidth="260" minWidth="260"/>
        </columns>
    </TableView>
</VBox>