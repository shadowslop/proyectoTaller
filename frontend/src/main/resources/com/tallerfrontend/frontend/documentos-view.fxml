<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.DocumentoController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Registrar Documento" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="comboVehiculo" promptText="Vehiculo (placa o tipo)" editable="true" prefWidth="220"/>
        <ComboBox fx:id="comboTipoDocumento" promptText="Tipo de documento"/>
        <ComboBox fx:id="comboEmpresa" promptText="Empresa" editable="true" prefWidth="200"/>
        <DatePicker fx:id="fechaVencimiento" promptText="Fecha de vencimiento"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="botonGuardar" text="Crear documento" onAction="#handleCrear"/>
        <Button fx:id="botonCancelarEdicion" text="Cancelar edicion" onAction="#handleCancelarEdicion" visible="false" managed="false"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <Separator/>

    <Label text="Consultar Documentos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="comboPlacaBusqueda" promptText="Vehiculo (placa o tipo)" editable="true" prefWidth="240"/>
        <Button text="Buscar" onAction="#handleBuscarPorVehiculo"/>
        <Button text="Ver vencidos" onAction="#handleVerVencidos"/>
        <Button text="Ver por vencer (30 días)" onAction="#handleVerPorVencer"/>
    </HBox>

    <TableView fx:id="tablaDocumentos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPlaca" text="Placa" prefWidth="100"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="140"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="160"/>
            <TableColumn fx:id="colVencimiento" text="Vencimiento" prefWidth="140"/>
            <TableColumn fx:id="colAccion" text="Accion" prefWidth="220" minWidth="220"/>
        </columns>
    </TableView>
</VBox>