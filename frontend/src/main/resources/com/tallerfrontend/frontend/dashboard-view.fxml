<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tallerfrontend.frontend.Controller.DashboardController">

    <top>
        <HBox fx:id="bannerAlertas" spacing="12" alignment="CENTER_LEFT" visible="false" managed="false"
              style="-fx-background-color: #fff3cd; -fx-padding: 10 16 10 16;">
            <Label fx:id="labelAlertas" style="-fx-text-fill: #664d03; -fx-font-weight: bold;"/>
            <Button text="Ver documentos" onAction="#mostrarDocumentos"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="8" prefWidth="200" style="-fx-background-color: #2b2b2b; -fx-padding: 16;">
            <Label fx:id="labelBienvenida" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="Prestamos" maxWidth="Infinity" onAction="#mostrarPrestamos"/>
            <Button text="Reservas" maxWidth="Infinity" onAction="#mostrarReservas"/>
            <Button text="Clientes" maxWidth="Infinity" onAction="#mostrarClientes"/>
            <Button text="Vehiculos" maxWidth="Infinity" onAction="#mostrarVehiculos"/>
            <Button fx:id="botonTiposVehiculo" text="Tipos de Vehiculo" maxWidth="Infinity" onAction="#mostrarTiposVehiculo"/>
            <Button fx:id="botonDocumentos" text="Documentos" maxWidth="Infinity" onAction="#mostrarDocumentos"/>
            <Button fx:id="botonUsuarios" text="Usuarios" maxWidth="Infinity" onAction="#mostrarUsuarios"/>
            <Button fx:id="botonMantenimientos" text="Mantenimientos" maxWidth="Infinity" onAction="#mostrarMantenimientos"/>
            <Button fx:id="botonReportes" text="Reportes" maxWidth="Infinity" onAction="#mostrarReportes"/>
            <Button fx:id="botonAuditoria" text="Auditoria" maxWidth="Infinity" onAction="#mostrarAuditoria"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesion" maxWidth="Infinity" onAction="#cerrarSesion"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="panelContenido">
            <Label text="Selecciona una seccion del menu" style="-fx-font-size: 16px;"/>
        </StackPane>
    </center>

</BorderPane>