<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tallerfrontend.frontend.Controller.MantenimientoController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <Label text="Agendar Mantenimiento" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="comboVehiculo" promptText="Vehiculo"/>
        <ComboBox fx:id="comboTipo" promptText="Tipo de mantenimiento"/>
        <DatePicker fx:id="campoFecha" promptText="Fecha"/>
        <Button fx:id="botonAgendar" text="Agendar" onAction="#handleAgendar"/>
    </HBox>

    <Label fx:id="labelError" style="-fx-text-fill: red;" visible="false"/>

    <TableView fx:id="tablaMantenimientos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colVehiculo" text="Placa" prefWidth="90"/>
            <TableColumn fx:id="colTipoVehiculo" text="Tipo vehiculo" prefWidth="110"/>
            <TableColumn fx:id="colTipoMantenimiento" text="Mantenimiento" prefWidth="120"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="colBloqueaHoy" text="Bloquea hoy" prefWidth="120"/>
            <TableColumn fx:id="colAccion" text="Accion" prefWidth="90"/>
        </columns>
    </TableView>
</VBox>